PORT=3000
# Replace placeholders with a dedicated local development database and role.
# URL-encode special characters in the password. Never commit server/.env.
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@localhost:5432/customer_inquiry_dev?schema=public
# Required: generate at least 32 random bytes (see README). No default secret.
SESSION_SECRET=
TRUSTED_ORIGINS=http://localhost:5173
NODE_ENV=development
# Only set loopback behind a local reverse proxy that overwrites X-Forwarded-*.
# Leave empty for the Vite development proxy.
TRUST_PROXY=
